# Explicit Wasmer/Anybuild definition for БИТВА ШКОЛ.
# We intentionally keep the dependency manifest outside the project root so
# Wasmer does not inject a legacy `pip install -r requirements.txt` step.
load("//anybuild/tools:python.bzl", "python_build", "python_config", "python_serve")

config = python_config(
    schema = 1,
    commands = {
        "start": "uvicorn app.main:app --host 0.0.0.0 --port $PORT",
    },
    python_main_file = "app/main.py",
    python_version = "3.13",
    python_server = "uvicorn",
    python_framework = "fastapi",
    asgi_application = "app.main:app",
    python_extra_dependencies = [
        "fastapi>=0.116,<1",
        "uvicorn[standard]>=0.35,<1",
        "SQLAlchemy>=2.0.52,<2.1",
        "psycopg[binary]>=3.2,<4",
        "PyMySQL>=1.1,<2",
        "certifi>=2025.10,<2027",
        "aiohttp>=3.11,<4",
        "Pillow>=11,<13",
        "python-multipart>=0.0.20,<1",
    ],
)

build = python_build(config)
python_serve(config, build, name = "bitva-shkol")
